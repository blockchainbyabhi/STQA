          "id": "dede7c3b-eb30-4ce0-b7aa-2d7d821176e0",
          "comment": "",
          "command": "executeScript",
          "target": "var e=document.getElementById('password');var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(e,'secret_sauce');e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));",
