          "comment": "",
          "command": "executeScript",
          "target": "var e=document.getElementById('user-name');var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(e,'standard_user');e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));",
